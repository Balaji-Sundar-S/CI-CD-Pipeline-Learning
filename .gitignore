## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
build/
bld/
[Bb]in/
[Oo]bj/

# Visual Studio cache/options directory
.vs/

# Test Results
TestResults/
test-results.trx
*.trx
coverage.cobertura.xml
TestResult.xml

# NuGet Packages
*.nupkg
**/packages/*

# Visual Studio Code
.vscode/

# JetBrains Rider
.idea/
*.sln.iml

# Windows
Thumbs.db
Desktop.ini

# Mac
.DS_Store

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/